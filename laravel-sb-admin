'app/Http/Controllers/InventarisController.php' => <<<'CODE'
<?php

namespace App\Http\Controllers;

use App\Models\Barang;
use App\Models\Kategori;
use App\Models\Lokasi;
use App\Models\Supplier;
use Illuminate\Http\Request;
use Illuminate\Validation\Rule;

class InventarisController extends Controller
{
    public function index(Request $request)
    {
        $jenis = $request->get('jenis', 'dashboard');
        $data = [];

        if ($jenis == 'barang') {
            $data = Barang::with(['kategori','lokasi','supplier'])->latest()->get();
        } elseif ($jenis == 'kategori') {
            $data = Kategori::latest()->get();
        } elseif ($jenis == 'lokasi') {
            $data = Lokasi::latest()->get();
        } elseif ($jenis == 'supplier') {
            $data = Supplier::latest()->get();
        }

        return view('inventaris', [
            'jenis' => $jenis,
            'data' => $data,
            'totalBarang' => Barang::count(),
            'totalKategori' => Kategori::count(),
            'totalLokasi' => Lokasi::count(),
            'totalSupplier' => Supplier::count(),
        ]);
    }

    public function store(Request $request)
    {
        $jenis = $request->jenis;

        if ($jenis == 'kategori') {
            $request->validate([
                'nama_kategori' => 'required',
                'deskripsi' => 'nullable'
            ]);
            Kategori::create($request->only('nama_kategori','deskripsi'));
        } elseif ($jenis == 'lokasi') {
            $request->validate([
                'nama_lokasi' => 'required',
                'keterangan' => 'nullable'
            ]);
            Lokasi::create($request->only('nama_lokasi','keterangan'));
        } elseif ($jenis == 'supplier') {
            $request->validate([
                'nama_supplier' => 'required',
                'telepon' => 'nullable',
                'alamat' => 'nullable'
            ]);
            Supplier::create($request->only('nama_supplier','telepon','alamat'));
        } elseif ($jenis == 'barang') {
            $request->validate([
                'kategori_id' => 'required|exists:kategoris,id',
                'lokasi_id' => 'required|exists:lokasis,id',
                'supplier_id' => 'nullable|exists:suppliers,id',
                'kode' => 'required|unique:barangs,kode',
                'nama_barang' => 'required',
                'jumlah' => 'required|integer|min:0',
                'kondisi' => 'required|in:Baik,Rusak'
            ]);
            Barang::create($request->only(
                'kategori_id','lokasi_id','supplier_id',
                'kode','nama_barang','jumlah','kondisi'
            ));
        }

        return redirect('/inventaris?jenis='.$jenis)->with('success','Data berhasil disimpan!');
    }

    public function update(Request $request, $jenis, $id)
    {
        if ($jenis == 'kategori') {
            $item = Kategori::findOrFail($id);
            $item->update($request->validate([
                'nama_kategori' => 'required',
                'deskripsi' => 'nullable'
            ]));
        } elseif ($jenis == 'lokasi') {
            $item = Lokasi::findOrFail($id);
            $item->update($request->validate([
                'nama_lokasi' => 'required',
                'keterangan' => 'nullable'
            ]));
        } elseif ($jenis == 'supplier') {
            $item = Supplier::findOrFail($id);
            $item->update($request->validate([
                'nama_supplier' => 'required',
                'telepon' => 'nullable',
                'alamat' => 'nullable'
            ]));
        } elseif ($jenis == 'barang') {
            $item = Barang::findOrFail($id);
            $item->update($request->validate([
                'kategori_id' => 'required|exists:kategoris,id',
                'lokasi_id' => 'required|exists:lokasis,id',
                'supplier_id' => 'nullable|exists:suppliers,id',
                'kode' => ['required',Rule::unique('barangs','kode')->ignore($id)],
                'nama_barang' => 'required',
                'jumlah' => 'required|integer|min:0',
                'kondisi' => 'required|in:Baik,Rusak'
            ]));
        }

        return redirect('/inventaris?jenis='.$jenis)->with('success','Data berhasil diubah!');
    }

    public function destroy($jenis, $id)
    {
        $model = match($jenis) {
            'barang' => Barang::class,
            'kategori' => Kategori::class,
            'lokasi' => Lokasi::class,
            'supplier' => Supplier::class,
            default => abort(404)
        };

        $model::findOrFail($id)->delete();

        return redirect('/inventaris?jenis='.$jenis)->with('success','Data berhasil dihapus!');
    }
}
